<div class="mx-auto mt-10 bg-white p-8 rounded-xl shadow">
    <h1 class="text-2xl font-bold mb-6">Editando Perfil</h1>

    <%= form_with model: @student, url: student_path(@student), method: :patch, local: true do |f| %>
      <div class="mb-4">
        <%= f.label :pronoun, "Pronome", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :pronoun,
              value: @student.user.pronoun,
              class: "w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div class="mb-4">
        <%= f.label :password, "Nova senha", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= password_field_tag :password,
              nil,
              class: "w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div class="mb-6">
        <%= f.label :password_confirmation, "Confirmar senha", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= password_field_tag :password_confirmation,
              nil,
              class: "w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <hr class="my-6">

      <div class="mb-4">
        <%= f.label :pretended_career, "Carreira pretendida", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :pretended_career,
              class: "w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div class="mb-6">
        <%= f.label :lattes_link, "Link do Lattes", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :lattes_link,
              class: "w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div>
        <%= f.submit "Salvar alterações",
              class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition" %>
      </div>

      <div>
        <%= link_to "Voltar à home", student_home_path, class: "px-4 py-2 text-gray-600 hover:text-gray-800 font-semibold" %>
      </div>
    <% end %>
  </div>